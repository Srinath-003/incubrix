# IncuBrix Distribution - Environment Configuration Template
# Copy this file to .env for local development: cp .env.example .env
# NEVER commit .env to source control or store real secrets here.

# Application Settings
APP_NAME="IncuBrix Distribution Engine"
APP_ENV="development"
APP_HOST="0.0.0.0"
APP_PORT=8000
DEBUG=false
LOG_LEVEL="INFO"

# MongoDB Configuration
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB_NAME="incubrix"
MONGODB_TIMEOUT_MS=2000

# Security (Set a strong random key in production)
SECRET_KEY="development-only-secret-key-change-in-production"
