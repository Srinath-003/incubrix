# IncuBrix Distribution - Environment Configuration Template
# Copy this file to .env for local development: cp .env.example .env
# NEVER commit .env to source control or store real secrets here.

# Application Settings
APP_NAME="IncuBrix Distribution Engine"
APP_ENV="development"
APP_HOST="0.0.0.0"
APP_PORT=8000
DEBUG=false
LOG_LEVEL="INFO"

# MongoDB Configuration
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB_NAME="incubrix"
MONGODB_TIMEOUT_MS=2000

# Security (Set a strong random key in production)
SECRET_KEY="development-only-secret-key-change-in-production"

# Phase 2: Simulation Mode & Destination Safety
# Defaults to true for safe local testing without external credentials or public posting
SIMULATION_MODE=true

# Set to true only when testing against an owned local test instance (e.g., localhost Discourse)
ALLOW_LOCAL_DESTINATIONS=false

# Optional: URL of an explicitly owned Discourse test instance for integration verification
DISCOURSE_TEST_URL="https://discourse.example.com"
